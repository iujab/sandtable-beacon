# Copy to .env (git-ignored) and fill in what you have. Read at start by sandtable/config.py; values are never printed.
# Check with: python -m sandtable.adapters.check          (add --live to try every layer live)

# --- modes: fixture (default, the public demo) or live (sponsor data; everything it touches stays under data/live/)
# One switch for all three layers
SANDTABLE_DATA_MODE=
# Per-layer overrides of SANDTABLE_DATA_MODE
COSTAR_MODE=
MATTERPORT_MODE=
VEXCEL_MODE=

# --- CoStar: a local CoStar Data Extract (files), not an HTTP API
# Folder of the unzipped extract (default: data/live/costar/)
COSTAR_KIT_DIR=
# Password of the extract zip, used by: python -m sandtable.adapters.costar_extract unzip <zip>
COSTAR_KIT_ZIP_PASSWORD=
# CoStar property id of the demo building (else data/live/demo_building.json, else the address below)
COSTAR_PROPERTY_ID=
# Street address of the demo building, used when no property id is given
COSTAR_PROPERTY_ADDRESS=

# --- Matterport
# API token id (Model API, GraphQL, HTTP basic auth)
MATTERPORT_TOKEN_ID=
# API token secret
MATTERPORT_TOKEN_SECRET=
# Model (space) id of the demo building: the part after ?m= in the showcase link
MATTERPORT_MODEL_ID=
# Showcase SDK key for the browser view; it only works on pages served from localhost
MATTERPORT_SDK_KEY=
# Storey of the scanned space in the building (else data/live/demo_building.json "floor")
MATTERPORT_STOREY=
# Suite number of the scanned space, to join it to the record's tenants (else demo_building.json "suite")
MATTERPORT_SUITE=
# Floor id of the twin that the exercise rig maps to (default: chosen by the adapter)
MATTERPORT_EXERCISE_FLOOR=
# 1 = refetch from the Model API instead of reusing data/live/matterport/cache/
MATTERPORT_REFRESH=
# 1 = really write the agent's observations to the model as tags (default: dry run, kept locally)
MATTERPORT_WRITE_TAGS=

# --- Vexcel
# API key (X-API-KEY header); also works for the Vexcel MCP server
VEXCEL_API_KEY=
# 1 = never call the API, serve only what data/live/vexcel/cache/ already holds
VEXCEL_OFFLINE=

# --- public context and private data
# A site.json (or its folder) to merge the record with; default: data/live/site/<demo building>/ in live mode
SANDTABLE_SITE=
# Where runtime data goes (default: data/); live data always goes to <this>/live/
SANDTABLE_DATA_DIR=

# --- model
# replay (recorded runs, offline), claude-cli (bench only) or anthropic
LLM_BACKEND=
# 1 = record real model answers into the replay cache (data/live/llm_cache/ in live mode; never fixtures/ then)
LLM_RECORD=
# Anthropic API key for LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=

# --- network
# Address the board binds to (default 127.0.0.1)
HOST=
# Board port (default 1810)
PORT=
