#include "SEGGER_RTT.h"

#if !defined(ROLE_INITIATOR) && !defined(ROLE_RESPONDER)
#error "define ROLE_INITIATOR or ROLE_RESPONDER"
#endif

/*
 * Workaround for a stack overwrite in the prebuilt dwt_uwb_driver 6.0.7 (m4-hfp):
 * the dwt_getframelength() wrapper keeps its uint16_t result at sp+6, directly
 * below its saved r4, and the driver ioctl behind it stores 32 bits there. The
 * top two (zero) bytes land on the saved r4, so the *caller's* r4 comes back with
 * its low half zeroed (seen live: 0x20000258 -> 0x20000000). dwt_readclockoffset()
 * has the identical frame layout. These shims save/restore r4 around the call.
 */
__attribute__((naked, noinline)) static uint16_t safe_getframelength(void)
{
    __asm volatile("push {r4, lr}\n\t"
                   "bl dwt_getframelength\n\t"
                   "pop {r4, pc}\n\t");
}
__attribute__((naked, noinline)) static int16_t safe_readclockoffset(void)
{
    __asm volatile("push {r4, lr}\n\t"
                   "bl dwt_readclockoffset\n\t"
                   "pop {r4, pc}\n\t");
}
