static void dw_bringup(const char *role)
{
.
104a
    CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk;
    DWT->CYCCNT = 0;
    DWT->CTRL |= DWT_CTRL_CYCCNTENA_Msk;
    cyc_last = 0;
    cyc_acc = 0;
}
static uint32_t uptime_s(void)
{
    uint32_t now = DWT->CYCCNT;
    cyc_acc += (uint32_t)(now - cyc_last);
    cyc_last = now;
    return (uint32_t)(cyc_acc / 64000000ULL);
}
static void maybe_announce(const char *role)
{
    uint32_t up = uptime_s();
    if (up >= next_id_s)
    {
        next_id_s = up + 5;
        snprintf(line, sizeof(line), "ID,%s,%08lX,%08lX%08lX,%lu", role, (unsigned long)dw_dev_id,
                 (unsigned long)NRF_FICR->DEVICEID[1], (unsigned long)NRF_FICR->DEVICEID[0], (unsigned long)up);
        out();
    }
}
