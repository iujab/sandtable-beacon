{
  "name": "static-cal",
  "description": "Tag held perfectly still at the known point (2.5, 2.0, 1.0) in the 6 x 4.5 m office, all line-of-sight, default noise: for anchor calibration and noise/accuracy studies.",
  "dims": 2,
  "profile": "4A1T",
  "rate_hz": 10,
