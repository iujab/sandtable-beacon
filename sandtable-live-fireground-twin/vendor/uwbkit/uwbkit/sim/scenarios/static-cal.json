  },
  "anchors": {
    "A1": {"x": 0.0, "y": 0.0, "z": 2.0},
    "A2": {"x": 6.0, "y": 0.0, "z": 2.0},
    "A3": {"x": 6.0, "y": 4.5, "z": 2.0},
    "A4": {"x": 0.0, "y": 4.5, "z": 2.0}
  },
  "nodes": {
    "T1": {"role": "tag", "label": "reference", "z": 1.0, "at": [2.5, 2.0]}
  },
  "noise": {"sigma_m": 0.08, "nlos_extra_sigma_m": 0.15, "outlier_prob": 0.02, "outlier_m": 1.5, "dropout_prob": 0.03},
  "seed": 3
